# LLM provider: openai or anthropic
LLM_PROVIDER=openai

# Set the key for the selected provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides.
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_MODEL=gpt-5.6-sol

# Active knowledge profile. Change this file to swap knowledge without editing code.
KNOWLEDGE_CONFIG_PATH=config/knowledge.toml

# Optional: Langfuse Cloud tracing / audit logs.
# EU: https://cloud.langfuse.com
# US: https://us.cloud.langfuse.com
# JP: https://jp.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENABLED=false
